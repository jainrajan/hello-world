CREATE OR REPLACE FUNCTION get_api_payload (p_id IN NUMBER) 
RETURN VARCHAR2 IS
    v_body      VARCHAR2(32767);
    v_emp_name  VARCHAR2(100);
    v_dept_name VARCHAR2(100);
    v_location  VARCHAR2(100);
BEGIN
    -- Fetch data from various tables into variables
    SELECT e.first_name || ' ' || e.last_name, 
           d.department_name, 
           l.city
    INTO   v_emp_name, 
           v_dept_name, 
           v_location
    FROM   employees e
    JOIN   departments d ON e.department_id = d.department_id
    JOIN   locations l   ON d.location_id = l.location_id
    WHERE  e.employee_id = p_id;

    -- Manually build the XML string
    v_body := '<EmployeeRequest>';
    v_body := v_body || '<Name>'     || v_emp_name  || '</Name>';
    v_body := v_body || '<Dept>'     || v_dept_name || '</Dept>';
    v_body := v_body || '<Location>' || v_location  || '</Location>';
    v_body := v_body || '</EmployeeRequest>';

    RETURN v_body;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN '<Error>Record not found</Error>';
    WHEN OTHERS THEN
        RETURN '<Error>' || SQLERRM || '</Error>';
END;
/
